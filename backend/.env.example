APP_NAME=Y-Lingo API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ylingodb
LOG_LEVEL=INFO

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── AI / Groq ─────────────────────────────────────────────────────────────────
# Required — used for LLM (conversations) AND STT (Groq Whisper)
GROQ_API_KEY=your-groq-api-key-here

# ── TTS / ElevenLabs ─────────────────────────────────────────────────────────
# Required for voice TTS. Get a free key at https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ── Email / SMTP (Password Reset) ────────────────────────────────────────────
# Used to send 6-digit password reset OTP codes.
#
# Gmail example (use an App Password, not your real Gmail password):
#   1. Enable 2-step verification on your Google account
#   2. Go to Google Account → Security → App Passwords
#   3. Generate an app password and paste it as SMTP_PASSWORD below
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Y-Lingo

# OTP expiry in minutes (default: 15)
PASSWORD_RESET_CODE_EXPIRE_MINUTES=15

# ── Optional ─────────────────────────────────────────────────────────────────
# OpenAI key (not required — Groq handles STT and LLM)
# OPENAI_API_KEY=your-openai-api-key-here

# Embedding provider for RAG (default: sentence-transformers, runs locally)
# EMBEDDING_PROVIDER=sentence-transformers
