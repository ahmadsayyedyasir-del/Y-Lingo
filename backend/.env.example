# Application
APP_NAME=Y-Lingo API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated origins (Next.js local + production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL) — used from Phase 2 onward
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ylingodb

# Logging
LOG_LEVEL=INFO

# Security placeholders (Auth phase — do not use weak values in production)
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30